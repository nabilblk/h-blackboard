{
  "name": "harakiri-blackboard",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node bin/dev.mjs",
    "dev:landing": "vite --port 4514",
    "desktop": "node bin/desktop/start.mjs",
    "desktop:build": "tsc -p tsconfig.json && node bin/desktop/build.mjs",
    "desktop:package": "tsc -p tsconfig.json && node bin/desktop/package.mjs",
    "desktop:dmg": "npm run desktop:package && node bin/desktop/dmg.mjs",
    "test:desktop": "node --test tests/desktop-*.test.mjs",
    "test:desktop:native": "npm run desktop:build && node tests/desktop-native.mjs",
    "test:desktop:package": "npm run desktop:package && node tests/desktop-native.mjs --packaged",
    "node:package": "node bin/node/build.mjs",
    "node:types": "node bin/node/types.mjs",
    "test:node": "cargo test --locked --workspace && cargo build --locked --bins && node bin/node/types.mjs --check && node --test tests/p2p/*.test.mjs",
    "check:node": "cargo fmt --all -- --check && cargo clippy --locked --workspace --lib --bins -- -D warnings",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --env-file-if-exists=var/tunnel.env server/http.mjs",
    "test": "node --test tests/*.test.mjs",
    "agent": "node bin/harakiri.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/*.mjs\" \"bin/**/*.mjs\" \"desktop/**/*.{mjs,cjs}\" \"tests/**/*.mjs\" \"shared/*.{mjs,json}\"",
    "test:live": "node tests/runtime-live.mjs",
    "test:live:grok": "node tests/grok-live.mjs",
    "test:desktop:peers": "npm run desktop:build && node tests/desktop-peers-native.mjs",
    "test:g6": "node tests/experiments/g6-rehearsal.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cborg": "6.1.3",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "harakiri": "bin/harakiri.mjs"
  }
}
